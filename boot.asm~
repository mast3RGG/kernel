global _start

section .multiboot
align 4
dd 0x1BADB002
dd 0x00
dd -(0x1BADB002 + 0x00)

section .text
bits 32

_start:
    mov esp , stack_top

    mov eax , p3_table
    or  eax , 0b11
    mov [p4_table], eax

    mov eax , p2_table
    or eax , 0b11
    mov [p3_table] , eax

    mov ecx , 0

.map_p2_table:
    mov eax , 0x200000
    mul ecx
    or eax , 0x83
    mov [p2_table + ecx * 8] , eax

    inc ecx
    cmp ecx , 512
    jne .map_p2_table

    mov eax , p4_table
    mov cr3 , eax

    mov eax , cr4
    or eax , 0x20
    mov cr4 , eax

    mov ecx , 0xC0000080
    rdmsr
    or eax , 0x100
    wrmsr

    mov eax, cr0
    or eax, 0x80000000
    mov cr0, eax

    lgdt [gdt64.pointer]
    jmp 8:.long_mode

.long_mode:
	
    bits 64
    extern kernel_main
    mov ax, 0
    mov ss, ax
    mov ds, ax
    mov es, ax
    mov fs, ax
    mov gs, ax

    mov rsp, stack_top

    call kernel_main

    cli
.halt:
    hlt
    jmp .halt
	
    

section .bss
align 4096
p4_table:
    resb 4096
p3_table:
    resb 4096
p2_table:
    resb 4096
stack_bottom:
    resb 4096
stack_top:

section .rodata
gdt64:
    dq 0
.code:
    dq (1<<43) | (1<<44) | (1<<47) | (1<<53)
.pointer:
    dw $ - gdt64 - 1
    dq gdt64
